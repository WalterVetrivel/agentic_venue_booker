# Copy to backend/.env and fill in.
APP_SECRET=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./storage/app.db

# LLM providers (used from Phase 5)
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_PROVIDER=groq

# Document search (Phase 4). With Ollama running and `ollama pull nomic-embed-text`, search
# combines keywords and meaning; set EMBEDDINGS=off to use keyword search only.
EMBEDDINGS=ollama
EMBED_MODEL=nomic-embed-text
