# Copy to backend/.env and fill in.
APP_SECRET=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./storage/app.db

# LLM providers for the assistant. The Director can override these on the Settings page.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
DEFAULT_LLM_PROVIDER=groq

# Document search (Phase 4). With Ollama running and `ollama pull nomic-embed-text`, search
# combines keywords and meaning; set EMBEDDINGS=off to use keyword search only.
EMBEDDINGS=ollama
EMBED_MODEL=nomic-embed-text
# Keep the embedding model loaded this long after each search (-1 = always; Ollama's default is 5m).
EMBED_KEEP_ALIVE=8h

# Email for student requests (tracking number and status updates). Leave SMTP_HOST empty to
# save emails to storage/outbox instead of sending them. Gmail: see docs/EMAIL.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_URL=http://localhost:8080
# Only accept student contact emails on this domain (e.g. kiot.ac.in). Empty accepts any address.
STUDENT_EMAIL_DOMAIN=
# Our own limits on visitors (chat questions, student requests). Off for demos; true before real use.
RATE_LIMITS=false
